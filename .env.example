# Copy to .env and fill in. Never commit .env.

# Postgres. Local Docker: postgres://fsx:fsx@localhost:5432/fsx
# Leave empty to use the embedded PGlite database in ./.data (no Docker needed).
DATABASE_URL=

# Protects /api/cron/snapshot. Any long random string.
CRON_SECRET=

# Optional: enables the AI tutor. Without it the tutor shows an "offline" message.
ANTHROPIC_API_KEY=
# Optional override; default is claude-haiku-5-5 (see docs/decisions/0005).
FSX_TUTOR_MODEL=

# Optional: SEC asks automated clients to identify themselves, e.g. "FSX demo you@example.com".
# Without it, company values come from the checked-in seed file.
SEC_USER_AGENT=

# Sleeper username used for the demo portfolio
NEXT_PUBLIC_DEMO_SLEEPER_USER=johnrog
